# Ignore common development files
.git
.gitignore
*.md
!README.md
.DS_Store
.vscode
.idea

# Ignore Go artifacts
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
go.sum

# Ignore node_modules if any
node_modules

# Ignore test coverage
coverage.txt
coverage.html

# Ignore local builds
dist/
build/
bin/

# Schema is optional for users, keep it
!schema.json
