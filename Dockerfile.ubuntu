# Portal Builder Base Image (Ubuntu)
# Build environment for compiling LumeWeb Portal with custom plugins via docker buildx
# Use as a base image in your Dockerfile: FROM ghcr.io/lumeweb/portal-builder:ubuntu

FROM ubuntu:24.04

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Build arguments for yq version - override with --build-arg
ARG YQ_VERSION=v4.52.2

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    make \
    gcc \
    libc6-dev \
    libwebp-dev \
    ca-certificates \
    tzdata \
    python3 \
    python3-pip \
    curl \
    wget \
    unzip \
    software-properties-common \
    jq \
    nodejs \
    npm \
    && rm -rf /var/lib/apt/lists/*

# Install pnpm for frontend asset builds
RUN npm install -g pnpm@10

# Add Go PPA and install Go
RUN add-apt-repository -y ppa:longsleep/golang-backports && \
    apt-get update && \
    apt-get install -y golang-1.26 && \
    rm -rf /var/lib/apt/lists/*
ENV PATH=/usr/lib/go-1.26/bin:${PATH}

# Install yq (YAML parser)
# Version pinned for reproducible builds; checksum verified for security
# Automatically detects platform architecture for multi-platform builds
RUN ARCH=$(dpkg --print-architecture) && \
    if [ "$ARCH" = "arm64" ]; then \
        YQ_ARCH="yq_linux_arm64"; \
    else \
        YQ_ARCH="yq_linux_amd64"; \
    fi && \
    curl -fsSL -o /usr/local/bin/yq https://github.com/mikefarah/yq/releases/download/${YQ_VERSION}/${YQ_ARCH} && \
    chmod +x /usr/local/bin/yq

# Install xportal
RUN /usr/lib/go-1.26/bin/go install go.lumeweb.com/xportal/xcmd/xportal@latest

# Pre-populate Go module cache for common dependencies
# This significantly speeds up builds in child images by avoiding re-downloads
# Set explicit Go module cache path
ENV GOMODCACHE=/go/pkg/mod

# Create a temporary workspace for downloading modules
WORKDIR /tmp/cache-warmup

# Download Portal core dependencies (develop version)
# This creates go.mod and populates the module cache
RUN /usr/lib/go-1.26/bin/go mod init cache-warmup && \
    /usr/lib/go-1.26/bin/go get go.lumeweb.com/portal@develop && \
    /usr/lib/go-1.26/bin/go mod download go.lumeweb.com/portal@develop && \
    # Clean up temporary files
    rm -rf /tmp/cache-warmup

# Return to standard working directory
WORKDIR /workspace

# Install check-jsonschema for YAML validation using pip
RUN pip3 install --no-cache-dir --break-system-packages check-jsonschema

# Copy build script and schema
COPY build-portal.sh /usr/local/bin/build-portal
COPY schema.json /usr/local/share/portal-builder/schema.json
RUN chmod +x /usr/local/bin/build-portal

# Set default environment variables
ENV PLUGIN_MANIFEST=portal-plugins.yaml
ENV SCHEMA_PATH=/usr/local/share/portal-builder/schema.json
ENV OUTPUT_DIR=/dist
ENV PATH="/root/go/bin:/root/.local/bin:${PATH}"

# Set working directory
WORKDIR /workspace

# No ENTRYPOINT - this is a base image for buildx
# Users will RUN build-portal in their Dockerfiles
